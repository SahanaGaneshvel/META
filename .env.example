# Copy to .env (never commit .env). Fill in whichever partner key you have.
# Providers with a built-in URL: baseten, fireworks, groq, together, openrouter.
# For Modal (or anything else), leave _PROVIDER empty and set _BASE_URL to the endpoint URL.

# Muse Spark Open: the operator agent
HEADROOM_SPARK_PROVIDER=baseten
HEADROOM_SPARK_BASE_URL=
HEADROOM_SPARK_API_KEY=
# Baseten's hackathon id; other providers name it differently (check their model page)
HEADROOM_SPARK_MODEL=meta-models/muse-spark-open-1026

# Muse Glimmer: the offline backup operator (can be a different provider)
HEADROOM_GLIMMER_PROVIDER=fireworks
HEADROOM_GLIMMER_BASE_URL=
HEADROOM_GLIMMER_API_KEY=
HEADROOM_GLIMMER_MODEL=

# auto = replay recordings when they exist, else call live and record; live; replay (no network)
HEADROOM_MODEL_MODE=auto
